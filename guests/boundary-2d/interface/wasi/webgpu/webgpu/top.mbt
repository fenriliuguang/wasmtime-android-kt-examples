            SINT16X4 => 17
            UNORM16 => 18
            UNORM16X2 => 19
            UNORM16X4 => 20
            SNORM16 => 21
            SNORM16X2 => 22
            SNORM16X4 => 23
            FLOAT16 => 24
            FLOAT16X2 => 25
            FLOAT16X4 => 26
            FLOAT32 => 27
            FLOAT32X2 => 28
            FLOAT32X3 => 29
            FLOAT32X4 => 30
