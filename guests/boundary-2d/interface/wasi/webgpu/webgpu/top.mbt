///|
pub async fn GpuAdapter::request_device(self : GpuAdapter, descriptor : GpuDeviceDescriptor?) -> Result[GpuDevice, RequestDeviceError] {

      let lower_ptr : Int = mbt_ffi_malloc(56)
      defer mbt_ffi_free(lower_ptr)

      let GpuAdapter(handle) = self
      mbt_ffi_store32((lower_ptr + 0) + 0, handle)

      match (descriptor) {
            None => {
                  mbt_ffi_store8((lower_ptr + 4) + 0, (0))

                  ()
            }
            Some(payload0) => {
                  mbt_ffi_store8((lower_ptr + 4) + 0, (1))

                  match ((payload0).required_features) {
                        None => {
                              mbt_ffi_store8((lower_ptr + 4) + 4, (0))

                              ()
                        }
                        Some(payload2) => {
                              mbt_ffi_store8((lower_ptr + 4) + 4, (1))

                              let address = mbt_ffi_malloc((payload2).length() * 1);
                              for index = 0; index < (payload2).length(); index = index + 1 {
                                    let iter_elem : GpuFeatureName = (payload2)[(index)]
                                    let iter_base = address + (index * 1);
                                    mbt_ffi_store8((iter_base) + 0, iter_elem.ordinal())

                              }
                              mbt_ffi_store32((lower_ptr + 4) + 12, (payload2).length())
                              mbt_ffi_store32((lower_ptr + 4) + 8, address)

                              ()
                        }
                  }

                  match ((payload0).required_limits) {
                        None => {
                              mbt_ffi_store8((lower_ptr + 4) + 16, (0))

                              ()
                        }
                        Some(payload4) => {
                              mbt_ffi_store8((lower_ptr + 4) + 16, (1))

                              let RecordOptionGpuSize64(handle) = payload4
                              mbt_ffi_store32((lower_ptr + 4) + 20, handle)

                              ()
                        }
                  }

                  match ((payload0).default_queue) {
                        None => {
                              mbt_ffi_store8((lower_ptr + 4) + 24, (0))

                              ()
                        }
                        Some(payload6) => {
                              mbt_ffi_store8((lower_ptr + 4) + 24, (1))

                              match ((payload6).label) {
                                    None => {
                                          mbt_ffi_store8((lower_ptr + 4) + 28, (0))

                                          ()
                                    }
                                    Some(payload8) => {
                                          mbt_ffi_store8((lower_ptr + 4) + 28, (1))

                                          let ptr = mbt_ffi_str2ptr(payload8)
                                          mbt_ffi_store32((lower_ptr + 4) + 36, payload8.length())
                                          mbt_ffi_store32((lower_ptr + 4) + 32, ptr)

                                          ()
                                    }
                              }

                              ()
                        }
                  }

                  match ((payload0).label) {
                        None => {
                              mbt_ffi_store8((lower_ptr + 4) + 40, (0))

                              ()
                        }
                        Some(payload10) => {
                              mbt_ffi_store8((lower_ptr + 4) + 40, (1))

                              let ptr11 = mbt_ffi_str2ptr(payload10)
                              mbt_ffi_store32((lower_ptr + 4) + 48, payload10.length())
                              mbt_ffi_store32((lower_ptr + 4) + 44, ptr11)

                              ()
                        }
                  }

                  ()
            }
      }

      let result_ptr = mbt_ffi_malloc(16 * 1)
      defer mbt_ffi_free(result_ptr)

      let subtask_code = wasmImportMethodGpuAdapterRequestDevice(lower_ptr, result_ptr)
      @async-core.suspend_for_subtask(
      subtask_code,

      fn(before_started) {
            if before_started {

                  match (mbt_ffi_load8_u((lower_ptr) + 4)) {
                        0 => ()
                        1 => {

                              match (mbt_ffi_load8_u((lower_ptr) + 8)) {
                                    0 => ()
                                    1 => {
                                          mbt_ffi_free(mbt_ffi_load32((lower_ptr) + 12))

                                    }
                                    _ => panic()
                              }

                              match (mbt_ffi_load8_u((lower_ptr) + 20)) {
                                    0 => ()
                                    1 => {
                                          RecordOptionGpuSize64::RecordOptionGpuSize64(mbt_ffi_load32((lower_ptr) + 24)).drop()

                                    }
                                    _ => panic()
                              }

                              match (mbt_ffi_load8_u((lower_ptr) + 28)) {
                                    0 => ()
                                    1 => {

                                          match (mbt_ffi_load8_u((lower_ptr) + 32)) {
                                                0 => ()
                                                1 => {
                                                      mbt_ffi_free(mbt_ffi_load32((lower_ptr) + 36))

                                                }
                                                _ => panic()
                                          }

                                    }
                                    _ => panic()
                              }

                              match (mbt_ffi_load8_u((lower_ptr) + 44)) {
                                    0 => ()
                                    1 => {
                                          mbt_ffi_free(mbt_ffi_load32((lower_ptr) + 48))

                                    }
                                    _ => panic()
                              }

                        }
                        _ => panic()
                  }

            } else {

                  match (mbt_ffi_load8_u((lower_ptr) + 4)) {
                        0 => ()
                        1 => {

                              match (mbt_ffi_load8_u((lower_ptr) + 8)) {
                                    0 => ()
                                    1 => {
                                          mbt_ffi_free(mbt_ffi_load32((lower_ptr) + 12))

                                    }
                                    _ => panic()
                              }

                              match (mbt_ffi_load8_u((lower_ptr) + 20)) {
                                    0 => ()
                                    1 => ()
                                    _ => panic()
                              }

                              match (mbt_ffi_load8_u((lower_ptr) + 28)) {
                                    0 => ()
                                    1 => {

                                          match (mbt_ffi_load8_u((lower_ptr) + 32)) {
                                                0 => ()
                                                1 => {
                                                      mbt_ffi_free(mbt_ffi_load32((lower_ptr) + 36))

                                                }
                                                _ => panic()
                                          }

                                    }
                                    _ => panic()
                              }

                              match (mbt_ffi_load8_u((lower_ptr) + 44)) {
                                    0 => ()
                                    1 => {
                                          mbt_ffi_free(mbt_ffi_load32((lower_ptr) + 48))

                                    }
                                    _ => panic()
                              }

                        }
                        _ => panic()
                  }

            }
      }
      ,
      fn() {

            match (mbt_ffi_load8_u((result_ptr) + 0)) {
                  0 => {
                        GpuDevice::GpuDevice(mbt_ffi_load32((result_ptr) + 4)).drop()

                  }
                  1 => {
                        mbt_ffi_free(mbt_ffi_load32((result_ptr) + 8))

                  }
                  _ => panic()
            }

      },
      )

      let lifted0 = match (mbt_ffi_load8_u((result_ptr) + 0)) {
            0 => {

                  Result::Ok(GpuDevice::GpuDevice(mbt_ffi_load32((result_ptr) + 4)))
            }
            1 => {

                  let lifted = match (mbt_ffi_load8_u((result_ptr) + 4)) {
                        0 => {

                              RequestDeviceErrorKind::TypeError
                        }
                        1 => {

                              RequestDeviceErrorKind::OperationError
                        }
                        _ => panic()
                  }

                  let result = mbt_ffi_ptr2str(mbt_ffi_load32((result_ptr) + 8), mbt_ffi_load32((result_ptr) + 12))

                  Result::Err(RequestDeviceError::{kind : lifted, message : result})
            }
            _ => panic()
      }

      lifted0

}
///|
pub fn GpuAdapterInfo::vendor(self : GpuAdapterInfo) -> String {

      let GpuAdapterInfo(handle) = self
      let return_area = mbt_ffi_malloc(8)
      wasmImportMethodGpuAdapterInfoVendor(handle, return_area);

      let result = mbt_ffi_ptr2str(mbt_ffi_load32((return_area) + 0), mbt_ffi_load32((return_area) + 4))
      let ret = result
      mbt_ffi_free(return_area)
