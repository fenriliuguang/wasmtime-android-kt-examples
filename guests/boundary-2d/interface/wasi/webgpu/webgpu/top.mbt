///|
pub(all) struct GpuTextureUsage(Byte) derive(Show, Eq)
pub fn GpuTextureUsage::default() -> GpuTextureUsage {
      b'\x00'
}
pub(all) enum GpuTextureUsageFlag {
      COPY_SRC; COPY_DST; TEXTURE_BINDING; STORAGE_BINDING; RENDER_ATTACHMENT; TRANSIENT_ATTACHMENT
}
fn GpuTextureUsageFlag::value(self : GpuTextureUsageFlag) -> Byte {
      match self {
            COPY_SRC => ((1U << 0).to_byte())
            COPY_DST => ((1U << 1).to_byte())
            TEXTURE_BINDING => ((1U << 2).to_byte())
            STORAGE_BINDING => ((1U << 3).to_byte())
            RENDER_ATTACHMENT => ((1U << 4).to_byte())
            TRANSIENT_ATTACHMENT => ((1U << 5).to_byte())
      }
}
pub fn GpuTextureUsage::set(self : Self, other: GpuTextureUsageFlag) -> GpuTextureUsage {
      let GpuTextureUsage(flag) = self
      flag.lor(other.value())
}
pub fn GpuTextureUsage::unset(self : Self, other: GpuTextureUsageFlag) -> GpuTextureUsage {
      let GpuTextureUsage(flag) = self
      flag.land(other.value().lnot())
}
pub fn GpuTextureUsage::is_set(self : Self, other: GpuTextureUsageFlag) -> Bool {
      let GpuTextureUsage(flag) = self
      (flag.land(other.value()) == other.value())
}
