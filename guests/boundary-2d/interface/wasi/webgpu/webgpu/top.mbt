///|
pub async fn Gpu::request_adapter(self : Gpu, options : GpuRequestAdapterOptions?) -> GpuAdapter? {

      let lower_ptr : Int = mbt_ffi_malloc(28)
      defer mbt_ffi_free(lower_ptr)

      let Gpu(handle) = self
      mbt_ffi_store32((lower_ptr + 0) + 0, handle)

      match (options) {
            None => {
                  mbt_ffi_store8((lower_ptr + 4) + 0, (0))

                  ()
            }
            Some(payload0) => {
                  mbt_ffi_store8((lower_ptr + 4) + 0, (1))

                  match ((payload0).feature_level) {
                        None => {
                              mbt_ffi_store8((lower_ptr + 4) + 4, (0))

                              ()
                        }
                        Some(payload2) => {
                              mbt_ffi_store8((lower_ptr + 4) + 4, (1))

                              let ptr = mbt_ffi_str2ptr(payload2)
                              mbt_ffi_store32((lower_ptr + 4) + 12, payload2.length())
                              mbt_ffi_store32((lower_ptr + 4) + 8, ptr)

                              ()
                        }
                  }

                  match ((payload0).power_preference) {
                        None => {
                              mbt_ffi_store8((lower_ptr + 4) + 16, (0))

                              ()
                        }
                        Some(payload4) => {
                              mbt_ffi_store8((lower_ptr + 4) + 16, (1))
                              mbt_ffi_store8((lower_ptr + 4) + 17, payload4.ordinal())

                              ()
                        }
                  }

                  match ((payload0).force_fallback_adapter) {
                        None => {
                              mbt_ffi_store8((lower_ptr + 4) + 18, (0))

                              ()
                        }
                        Some(payload6) => {
                              mbt_ffi_store8((lower_ptr + 4) + 18, (1))
                              mbt_ffi_store8((lower_ptr + 4) + 19, (if payload6 { 1 } else { 0 }))

                              ()
                        }
                  }

                  match ((payload0).xr_compatible) {
                        None => {
                              mbt_ffi_store8((lower_ptr + 4) + 20, (0))

                              ()
                        }
                        Some(payload8) => {
                              mbt_ffi_store8((lower_ptr + 4) + 20, (1))
                              mbt_ffi_store8((lower_ptr + 4) + 21, (if payload8 { 1 } else { 0 }))

                              ()
                        }
                  }

                  ()
            }
      }

      let result_ptr = mbt_ffi_malloc(8 * 1)
      defer mbt_ffi_free(result_ptr)

      let subtask_code = wasmImportMethodGpuRequestAdapter(lower_ptr, result_ptr)
      @async-core.suspend_for_subtask(
      subtask_code,

      fn(before_started) {
            if before_started {

                  match (mbt_ffi_load8_u((lower_ptr) + 4)) {
                        0 => ()
                        1 => {

                              match (mbt_ffi_load8_u((lower_ptr) + 8)) {
                                    0 => ()
                                    1 => {
                                          mbt_ffi_free(mbt_ffi_load32((lower_ptr) + 12))

                                    }
                                    _ => panic()
                              }

                        }
                        _ => panic()
                  }

            } else {

                  match (mbt_ffi_load8_u((lower_ptr) + 4)) {
                        0 => ()
                        1 => {

                              match (mbt_ffi_load8_u((lower_ptr) + 8)) {
                                    0 => ()
                                    1 => {
                                          mbt_ffi_free(mbt_ffi_load32((lower_ptr) + 12))

                                    }
                                    _ => panic()
                              }

                        }
                        _ => panic()
                  }

            }
      }
      ,
      fn() {

            match (mbt_ffi_load8_u((result_ptr) + 0)) {
                  0 => ()
                  1 => {
                        GpuAdapter::GpuAdapter(mbt_ffi_load32((result_ptr) + 4)).drop()

                  }
                  _ => panic()
            }

      },
      )

      let lifted : GpuAdapter? = match mbt_ffi_load8_u((result_ptr) + 0) {
            0 => Option::None
            1 => {

                  Option::Some(GpuAdapter::GpuAdapter(mbt_ffi_load32((result_ptr) + 4)))
            }
            _ => panic()
      }

      lifted

}
