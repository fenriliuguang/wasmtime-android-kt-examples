                        }
                        _ => panic()
                  }

                  match (mbt_ffi_load8_u((lower_ptr) + 36)) {
                        0 => ()
                        1 => {
                              mbt_ffi_free(mbt_ffi_load32((lower_ptr) + 40))

                        }
                        _ => panic()
                  }

            } else {

                  match (mbt_ffi_load8_u((lower_ptr) + 8)) {
                        0 => ()
